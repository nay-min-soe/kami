# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Kami reads these from the process environment (it does not load .env itself),
# so export them first:  set -a; source .env; set +a

# API key for the LLM endpoint (OpenRouter by default, see config.example.toml).
# KAMI_API_KEY is checked first, then OPENROUTER_API_KEY.
KAMI_API_KEY=
OPENROUTER_API_KEY=

# Optional: override the config directory (default: ~/.config, giving ~/.config/kami/config.toml).
# XDG_CONFIG_HOME=
